# Copy to .env.local for local development. Everything is optional locally:
# without these, the app uses an in-process database (PGlite in .data/), writes
# mail to the mail_outbox table, captures Telegram messages, and skips the
# Claude pre-fill. Production values live in Vercel and GitHub secrets only;
# see docs/OPERATIONS.md. Never commit real values.

# LEDGER_ENV=production          # turns on fail-closed checks for every secret below
# SITE_URL=https://example.org

# Database (Neon, London region). Unset = PGlite locally.
# DATABASE_URL=postgres://…-pooler.eu-west-2.aws.neon.tech/ledger?sslmode=require

# 32 random bytes, base64: openssl rand -base64 32
# LEDGER_ENCRYPTION_KEY=
# LEDGER_LOOKUP_PEPPER=
# ALTCHA_HMAC_KEY=

# Mail: Resend (recommended) or Amazon SES; off, or the local outbox, when unset. docs/OPERATIONS.md §3.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=Public Ledger <alerts@example.org>
# MAIL_REPLY_TO=editors@example.org
# For SES instead (eu-west-2), with credentials via the standard AWS variables:
# MAIL_PROVIDER=ses
# SES_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Telegram bot (BotFather). Webhook secret: openssl rand -hex 32
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Claude API for submission pre-fill (suggestions for editors only).
# ANTHROPIC_API_KEY=
# PREFILL_MODEL=claude-opus-5-5
# INTAKE_MODEL=claude-opus-5-5

# Admin triage: interim basic auth until SSO is in front. Both unset = /admin is 404.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Draft pull requests from triage: fine-grained token, this repo only,
# Contents and Pull requests read/write.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=xternal/public-ledger

# FOLLOWER_COUNT_THRESHOLD=50
