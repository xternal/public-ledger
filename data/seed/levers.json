{
  "meta": {
    "note": "Static 'ready-reckoner' costings for the v0 sandbox. Central values with low/high range, £bn per year, 2025-26 prices. Values flagged 'training' are from model memory of HMRC/OBR ready reckoners and MUST be replaced by the ingestion job reading HMRC 'Direct effects of illustrative tax changes' and the OBR ready reckoner before public launch.",
    "sources": [
      {"id": "hmrc_ready_reckoner", "title": "HMRC: Direct effects of illustrative tax changes", "url": "https://www.gov.uk/government/statistics/direct-effects-of-illustrative-tax-changes"},
      {"id": "obr_ready_reckoner", "title": "OBR: Ready reckoners and sensitivities (EFO supplementary tables)", "url": "https://obr.uk/efo/economic-and-fiscal-outlook-march-2026/"}
    ]
  },
  "levers": [
    {"id": "bank_rate", "label": "Bank Rate", "unit": "pp", "base": 3.75, "min": 1.0, "max": 7.0, "step": 0.25,
     "effect": {"target": "debt_interest", "per_unit_bn": {"y1": [6, 8, 10], "y5": [16, 20, 24]}},
     "household": "mortgage", "quality": "training", "owner": "Bank of England MPC (not government)"},
    {"id": "income_tax_basic", "label": "Income tax basic rate", "unit": "pp", "base": 20, "min": 15, "max": 25, "step": 1,
     "effect": {"target": "income_tax", "per_unit_bn": {"y1": [6.8, 7.4, 8.0]}}, "quality": "training"},
    {"id": "nics_main", "label": "Employee NI main rate", "unit": "pp", "base": 8, "min": 4, "max": 12, "step": 1,
     "effect": {"target": "nics", "per_unit_bn": {"y1": [4.6, 5.0, 5.4]}}, "quality": "training"},
    {"id": "vat_standard", "label": "VAT standard rate", "unit": "pp", "base": 20, "min": 15, "max": 25, "step": 1,
     "effect": {"target": "vat", "per_unit_bn": {"y1": [7.8, 8.7, 9.4]}, "cpi_pp_per_unit": [0.4, 0.6, 0.8]}, "quality": "training"},
    {"id": "corp_tax", "label": "Corporation tax main rate", "unit": "pp", "base": 25, "min": 19, "max": 30, "step": 1,
     "effect": {"target": "corp_tax", "per_unit_bn": {"y1": [2.6, 3.5, 4.2]}}, "quality": "training"},
    {"id": "defence_gdp", "label": "Defence, % of GDP", "unit": "pct_gdp", "base": 2.3, "min": 2.0, "max": 5.0, "step": 0.1,
     "effect": {"target": "defence", "per_unit_bn": {"y1": [30.75, 30.75, 30.75]}}, "quality": "arithmetic", "note": "1pp of GDP ≈ £31bn at £3.08tn nominal GDP"},
    {"id": "health_change", "label": "NHS budget change", "unit": "pct", "base": 0, "min": -10, "max": 20, "step": 1,
     "effect": {"target": "health", "per_unit_bn": {"y1": [2.57, 2.57, 2.57]}}, "quality": "arithmetic"},
    {"id": "state_pension_change", "label": "State pension level", "unit": "pct", "base": 0, "min": -10, "max": 15, "step": 1,
     "effect": {"target": "social_protection", "per_unit_bn": {"y1": [1.46, 1.46, 1.46]}}, "quality": "arithmetic", "note": "State pension ≈ £146bn in 2025-26"},
    {"id": "bus_cap_2", "label": "£2 bus fare cap (England)", "unit": "toggle", "base": 0,
     "effect": {"target": "economic_affairs", "per_unit_bn": {"y1": [0.45, 0.5, 0.6]}}, "quality": "sourced",
     "source": "https://www.itv.com/news/2026-07-22/andy-burnham-unveils-2-bus-fare-cap-in-pledge-to-be-cost-of-living-government",
     "funding_options": [
       {"id": "borrow", "label": "Borrow it", "offset_bn": 0},
       {"id": "climate_loans", "label": "Turn £400m of climate aid into loans (government's choice)", "offset_bn": 0.4, "target": "general_services"},
       {"id": "fuel_duty", "label": "Raise fuel duty by 1p", "offset_bn": 0.5, "target": "fuel_duty", "quality": "training"}
     ]}
  ],
  "macro_rules": {
    "spending_multiplier": [0.4, 0.7, 1.0],
    "tax_multiplier": [0.2, 0.4, 0.6],
    "note": "Year-1 GDP effect = −multiplier × fiscal tightening / GDP. Ranges are deliberately wide; this is the v0 'arithmetic' tier of the model ensemble."
  }
}
